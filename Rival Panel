-- Guardado de Posiciones (Compatibilidad Solara)
local PosConfig = { PanelPos = nil, AVPos = nil }
local ConfigFileName = "AverisRival_Config.json"

local function safeReadFile(file)
    if typeof(readfile) == "function" and typeof(isfile) == "function" then
        local success, result = pcall(function()
            if isfile(file) then return readfile(file) end
        end)
        if success then return result end
    end
    return nil
end

local function safeWriteFile(file, data)
    if typeof(writefile) == "function" then
        pcall(function() writefile(file, data) end)
    end
end

local function loadSavedPos()
    local raw = safeReadFile(ConfigFileName)
    if raw then
        local HttpService = game:GetService("HttpService")
        local success, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
        if success and type(decoded) == "table" then
            PosConfig = decoded
        end
    end
end

local function savePos()
    local HttpService = game:GetService("HttpService")
    local success, encoded = pcall(function() return HttpService:JSONEncode(PosConfig) end)
    if success then safeWriteFile(ConfigFileName, encoded) end
end

