-- 5. ARRASTRE COMPATIBLE (PC Y MÓVIL)
-- ==========================================
local function makeDraggable(guiObject, saveKey)
    local dragging = false
    local dragInput, dragStart, startPos

    local function clampPosition(pos)
        local screenSize = workspace.CurrentCamera.ViewportSize
        local x = math.clamp(pos.X.Offset, 10 - pos.X.Scale * screenSize.X, screenSize.X - guiObject.AbsoluteSize.X - 10)
        local y = math.clamp(pos.Y.Offset, 10 - pos.Y.Scale * screenSize.Y, screenSize.Y - guiObject.AbsoluteSize.Y - 10)
        return UDim2.new(pos.X.Scale, x, pos.Y.Scale, y)
    end

    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    PosConfig[saveKey] = {
                        X = { Scale = guiObject.Position.X.Scale, Offset = guiObject.Position.X.Offset },
                        Y = { Scale = guiObject.Position.Y.Scale, Offset = guiObject.Position.Y.Offset }
                    }
                    savePos()
                end
            end)
        end
    end)

    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            guiObject.Position = clampPosition(newPos)
        end
    end)
end

