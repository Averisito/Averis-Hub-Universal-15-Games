-- Navegación
local activeTab = "General"
local function createCategoryButton(name, targetTab)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = (activeTab == name) and Color3.fromRGB(90, 30, 150) or Color3.fromRGB(22, 12, 35)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(230, 230, 230)
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.ZIndex = 4
    btn.Parent = SideBar

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        activeTab = name
        GeneralTab.Visible = (targetTab == GeneralTab)
        MM2Tab.Visible = (targetTab == MM2Tab)

        for _, v in ipairs(SideBar:GetChildren()) do
            if v:IsA("TextButton") then
                TweenService:Create(v, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(22, 12, 35)}):Play()
            end
        end
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(110, 35, 180)}):Play()
    end)
end

createCategoryButton("General", GeneralTab)
createCategoryButton("Murder Mystery 2", MM2Tab)

