	for k = 1, 8 do pts[#pts + 1] = ColorSequenceKeypoint.new(0.04 + (k / 8) * 0.96, Color3.fromHSV(k / 8, 0.85, 1)) end
	new("UIGradient", { Color = ColorSequence.new(pts), Parent = track })
