		notify("Copiado", s)
	else
		notify("Portapapeles", "Tu ejecutor no expone setclipboard.")
	end
end

--------------------------------------------------------------------
-- Planificador único (control de frecuencia)
--------------------------------------------------------------------
local Sched = { tasks = {}, conn = nil }
local function schedStep(dt)
	local list = {}
	for _, t in pairs(Sched.tasks) do list[#list + 1] = t end
	for _, t in ipairs(list) do
		if Sched.tasks[t.name] == t then
			t.acc += dt
			if t.acc >= t.interval then
				local d = t.acc
				t.acc = 0
				local ok, err = pcall(t.fn, d)
				if not ok then
					t.errors += 1
					warn("[AVERIS] " .. t.name .. ": " .. tostring(err))
					if t.errors >= 5 then
						Sched.tasks[t.name] = nil
						notify("Error", t.name .. " se detuvo por errores repetidos.")
					end
				end
			end
		end
	end
end
function Sched.add(name, interval, fn)
	Sched.tasks[name] = { name = name, interval = interval, acc = interval, fn = fn, errors = 0 }
	if not Sched.conn then Sched.conn = RunService.Heartbeat:Connect(schedStep) end
end
function Sched.remove(name) Sched.tasks[name] = nil end
function Sched.has(name) return Sched.tasks[name] ~= nil end
function Sched.setInterval(name, v) local t = Sched.tasks[name]; if t then t.interval = v end end
Janitor.add(function() if Sched.conn then Sched.conn:Disconnect(); Sched.conn = nil end Sched.tasks = {} end)

--------------------------------------------------------------------
-- Noclip compartido (con contador de usuarios)
--------------------------------------------------------------------
local NC = { users = {}, count = 0, conn = nil, parts = {}, changed = {} }
function NC.collect()
	NC.parts = {}
	local c = LocalPlayer.Character
	if c then
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("BasePart") then NC.parts[#NC.parts + 1] = d end
		end
	end
end
function NC.acquire(reason)
	if NC.users[reason] then return end
	NC.users[reason] = true
	NC.count += 1
	if NC.count == 1 then
		NC.collect()
		NC.conn = RunService.Stepped:Connect(function()
			for _, p in ipairs(NC.parts) do
				if p.Parent and p.CanCollide then NC.changed[p] = true; p.CanCollide = false end
			end
		end)
	end
end
function NC.release(reason)
	if not NC.users[reason] then return end
	NC.users[reason] = nil
	NC.count -= 1
	if NC.count <= 0 then
		NC.count = 0
		if NC.conn then NC.conn:Disconnect(); NC.conn = nil end
		for p in pairs(NC.changed) do if p.Parent then p.CanCollide = true end end
		NC.changed = {}
	end
end

