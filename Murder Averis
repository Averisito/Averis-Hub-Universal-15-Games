local Coins = { container = nil, esp = {} }
local function getCoinContainer()
	local c = Coins.container
	if c and c.Parent then return c end
	Coins.container = nil
	for _, m in ipairs(Workspace:GetChildren()) do
		if m:IsA("Model") then
			local cc = m:FindFirstChild("CoinContainer")
			if cc then Coins.container = cc return cc end
		end
	end
	return nil
end
local function listCoins()
	local out = {}
	local c = getCoinContainer()
	if c then
		for _, x in ipairs(c:GetChildren()) do
			if x:IsA("BasePart") then out[#out + 1] = x end
		end
	end
	return out
end
function Coins.clearESP()
	for c, g in pairs(Coins.esp) do pcall(function() g:Destroy() end); Coins.esp[c] = nil end
end
function Coins.updateESP()
	local set = {}
	for _, c in ipairs(listCoins()) do
		set[c] = true
		local g = Coins.esp[c]
		if not g then
			g = new("BillboardGui", { Adornee = c, AlwaysOnTop = true, Size = UDim2.fromOffset(10, 10), Parent = ESPFolder })
