local FlingS = { running = false, cancel = false, last = 0 }
local function stopFling() FlingS.cancel = true end
local function flingPlayer(target)
	if FlingS.running then notify("Fling", "Ya hay un fling en curso.") return end
	if tick() - FlingS.last < 1 then return end
	if not target or target == LocalPlayer or not target.Parent then notify("Fling", "Selecciona un objetivo válido.") return end
	if isIgnored(target) then notify("Fling", "El objetivo está en la lista de ignorados.") return end
	if not myRoot() or not isAlive(LocalPlayer) then notify("Fling", "Tu personaje no está disponible.") return end
	if not isAlive(target) then notify("Fling", "El objetivo no está vivo.") return end
	FlingS.running = true
	FlingS.cancel = false
	task.spawn(function()
		local root = myRoot()
		local origCF = root.CFrame
		NC.acquire("fling")
		local bav = new("BodyAngularVelocity", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), AngularVelocity = Vector3.new(0, O.flingPower * 1000, 0), P = 1e9, Parent = root })
		local t0 = tick()
		local ok, err = pcall(function()
			while not FlingS.cancel and tick() - t0 < O.flingDuration do
				local tr, mr = rootOf(target), myRoot()
				if not tr or not mr or not isAlive(target) or not isAlive(LocalPlayer) then break end
				mr.CFrame = tr.CFrame * CFrame.new(0, 0, O.flingOffset) + tr.AssemblyLinearVelocity * 0.1
				mr.AssemblyLinearVelocity = Vector3.new(O.flingPower * 2000, O.flingPower * 2000, O.flingPower * 2000)
				RunService.Heartbeat:Wait()
			end
		end)
		bav:Destroy()
		NC.release("fling")
		for _ = 1, 2 do
			local mr = myRoot()
			if mr then zeroVel(mr); mr.CFrame = origCF end
			task.wait(0.05)
		end
		FlingS.running = false
		FlingS.last = tick()
		if not ok then warn("[AVERIS] fling: " .. tostring(err)) end
	end)
end
