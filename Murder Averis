local flyBV, flyBG
defineFeature("Fly", function()
	local root, hum = myRoot(), myHum()
	if not root or not hum then return false end
	flyBV = new("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero, Parent = root })
	flyBG = new("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 9e4, CFrame = root.CFrame, Parent = root })
	hum.PlatformStand = true
	Sched.add("fly", 0, function()
		local r, h = myRoot(), myHum()
		if not r or not h or not flyBV or not flyBV.Parent then return end
		local cam = Workspace.CurrentCamera
		local md = h.MoveDirection
		local look, right = cam.CFrame.LookVector, cam.CFrame.RightVector
		local fl, fr = Vector3.new(look.X, 0, look.Z), Vector3.new(right.X, 0, right.Z)
		local f = fl.Magnitude > 0 and md:Dot(fl.Unit) or 0
		local rr = fr.Magnitude > 0 and md:Dot(fr.Unit) or 0
		local dir = look * f + right * rr
		if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
		flyBV.Velocity = dir * O.flySpeed
		local face = fl.Magnitude > 0 and fl or r.CFrame.LookVector
		flyBG.CFrame = CFrame.lookAt(r.Position, r.Position + face)
	end)
	return true
end, function()
	Sched.remove("fly")
	if flyBV then flyBV:Destroy(); flyBV = nil end
	if flyBG then flyBG:Destroy(); flyBG = nil end
	local h = myHum()
	if h then h.PlatformStand = false end
end, { restart = true })

