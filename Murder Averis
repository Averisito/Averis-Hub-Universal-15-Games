	return Round.holder
end

local KA = { running = false, cancel = false }
local function murderKillAll()
	if KA.running then notify("Kill All", "Ya está en ejecución.") return end
	if Roles[LocalPlayer] ~= "Murderer" then notify("Kill All", "Solo funciona siendo Murderer.") return end
	if not myRoot() then return end
	KA.running = true
	KA.cancel = false
	task.spawn(function()
		local origCF = myRoot().CFrame
		NC.acquire("killall")
		local killed = 0
		pcall(function()
			for _, p in ipairs(Players:GetPlayers()) do
				if KA.cancel then break end
				if p ~= LocalPlayer and isAlive(p) and not isIgnored(p) then
					local t0 = tick()
					while isAlive(p) and not KA.cancel and tick() - t0 < 2 do
						local knife, mr, tr = getTool("Knife", true), myRoot(), rootOf(p)
						if not knife or not mr or not tr then break end
						local pos = (tr.CFrame * CFrame.new(0, 0, 2.2)).Position
						mr.CFrame = CFrame.lookAt(pos, tr.Position)
						pcall(function() knife:Activate() end)
						local handle = knife:FindFirstChild("Handle")
						if CAP.touch and handle then
							pcall(firetouchinterest, tr, handle, 0)
							pcall(firetouchinterest, tr, handle, 1)
						end
						task.wait(O.killAllDelay)
					end
					if not isAlive(p) then killed += 1 end
				end
			end
		end)
		NC.release("killall")
		local mr = myRoot()
		if mr then mr.CFrame = origCF; zeroVel(mr) end
		KA.running = false
		notify("Kill All", "Finalizado. Eliminados: " .. killed)
	end)
end

