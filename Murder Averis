local function createToggle(name)
    local state = false
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(1, 0, 0, 36)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(18, 10, 28)
    toggleBtn.Text = "   " .. name .. ": OFF"
    toggleBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    toggleBtn.TextSize = 12
    toggleBtn.Font = Enum.Font.GothamMedium
    toggleBtn.TextXAlignment = Enum.TextXAlignment.Left
    toggleBtn.AutoButtonColor = false
    toggleBtn.ZIndex = 12
    toggleBtn.Parent = MM2Container

    local tCorner = Instance.new("UICorner")
    tCorner.CornerRadius = UDim.new(0, 6)
    tCorner.Parent = toggleBtn

    local tStroke = Instance.new("UIStroke")
    tStroke.Color = Color3.fromRGB(45, 20, 70)
    tStroke.Thickness = 1
    tStroke.Parent = toggleBtn

    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            toggleBtn.Text = "   " .. name .. ": ON"
            toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(110, 35, 180)}):Play()
            TweenService:Create(tStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(160, 50, 240)}):Play()
        else
            toggleBtn.Text = "   " .. name .. ": OFF"
            toggleBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
            TweenService:Create(toggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(18, 10, 28)}):Play()
            TweenService:Create(tStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 20, 70)}):Play()
        end
    end)
end

createToggle("Player ESP (Roles)")
