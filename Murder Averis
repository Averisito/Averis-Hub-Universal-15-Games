			new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = f })
			Coins.esp[c] = g
		end
		local f = g:FindFirstChildOfClass("Frame")
		if f then f.BackgroundColor3 = Config.colors.Coin end
	end
	for c, g in pairs(Coins.esp) do
		if not set[c] then pcall(function() g:Destroy() end); Coins.esp[c] = nil end
	end
end

