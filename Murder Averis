-- Información en vivo / HUD
--------------------------------------------------------------------
local function stat(p)
	if not p then return "—" end
	local d = dist(p)
	return string.format("%s (@%s) · %s · %s", p.DisplayName, p.Name, isAlive(p) and "vivo" or "muerto", d < math.huge and string.format("%.0f studs", d) or "—")
end
local function updateInfo()
	setInfo("round", "Estado de la partida: " .. (Round.active and "ronda en curso" or "lobby / sin ronda"))
	local role = Round.active and (Roles[LocalPlayer] or "—") or "—"
	setInfo("myrole", "Mi rol: " .. role .. " · " .. (isAlive(LocalPlayer) and "vivo" or "sin personaje"))
	setInfo("murd", "Murderer: " .. (Round.murderer and stat(Round.murderer) or "no detectado"))
	local sh = Round.holder
	setInfo("sheriff", "Arma: " .. (sh and ((Roles[sh] or "?") .. " → " .. stat(sh)) or (Round.active and "sin portador (caída o perdida)" or "—")))
	setInfo("coins", "Monedas en el mapa: " .. #listCoins())
	if HUD.Visible then
		hudL[1].Text = "AVERIS · " .. (Round.active and "Ronda" or "Lobby") .. " · Rol: " .. role
		hudL[2].Text = "Murderer: " .. (Round.murderer and (Round.murderer.DisplayName .. string.format(" · %.0fm", dist(Round.murderer) < math.huge and dist(Round.murderer) or 0)) or "—")
		hudL[3].Text = "Arma: " .. (sh and (sh.DisplayName .. " (" .. (Roles[sh] or "?") .. ")") or "—")
	end
end

--------------------------------------------------------------------
-- Entrada: teclas rápidas y arrastre de sliders
--------------------------------------------------------------------
Janitor.add(UIS.InputBegan:Connect(function(input, processed)
	if Binding.active then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			Config.keys[Binding.active.name] = (input.KeyCode == Enum.KeyCode.Escape) and "" or input.KeyCode.Name
			Binding.active.refresh()
			Binding.active = nil
		end
		return
	end
	if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
	local kn = input.KeyCode.Name
	for name, key in pairs(Config.keys) do
		if key ~= "" and key == kn then
			if name == "ToggleUI" then showUI(not uiVisible)
			elseif name == "Panic" then panic(); notify("AVERIS", "Todas las funciones detenidas.")
			elseif Features[name] then setFeature(name, not Features[name].on) end
		end
	end
end))
Janitor.add(UIS.InputChanged:Connect(function(i)
	if Drag.fn and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
		Drag.fn(i.Position.X)
	end
end))
Janitor.add(UIS.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Drag.fn = nil end
end))

