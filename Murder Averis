local Janitor = { items = {} }
function Janitor.add(x) Janitor.items[#Janitor.items + 1] = x return x end
function Janitor.clean()
	for i = #Janitor.items, 1, -1 do
		local it = Janitor.items[i]
		pcall(function()
			local t = typeof(it)
			if t == "RBXScriptConnection" then it:Disconnect()
			elseif t == "Instance" then it:Destroy()
			elseif t == "function" then it() end
		end)
	end
	Janitor.items = {}
end

local function new(class, props, kids)
	local o = Instance.new(class)
	local parent
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then parent = v else o[k] = v end
		end
	end
	if kids then for _, c in ipairs(kids) do c.Parent = o end end
	if parent then o.Parent = parent end
	return o
end

local function deepcopy(t)
	local r = {}
	for k, v in pairs(t) do r[k] = type(v) == "table" and deepcopy(v) or v end
	return r
end

