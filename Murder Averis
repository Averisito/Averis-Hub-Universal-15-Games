local Collect = { busy = false, visited = setmetatable({}, { __mode = "k" }) }
local function moveTo(pos, speed)
	local root = myRoot()
	if not root then return end
	local start = root.Position
	local dur = math.max((pos - start).Magnitude / speed, 0.05)
	local t0 = tick()
	NC.acquire("collect")
	pcall(function()
		while Features.AutoCollect.on do
			local a = (tick() - t0) / dur
			local r = myRoot()
			if not r or a >= 1 then break end
			r.CFrame = CFrame.new(start:Lerp(pos, a)) * r.CFrame.Rotation
			r.AssemblyLinearVelocity = Vector3.zero
			RunService.Heartbeat:Wait()
		end
		local r = myRoot()
		if r then r.CFrame = CFrame.new(pos) * r.CFrame.Rotation; zeroVel(r) end
	end)
	NC.release("collect")
end
defineFeature("AutoCollect", function()
	Collect.busy = false
	Sched.add("collect", 0.15, function()
		if Collect.busy or not Round.active or not isAlive(LocalPlayer) then return end
		local m = Round.murderer
		if Roles[LocalPlayer] ~= "Murderer" and m and O.collectSafe > 0 and isAlive(m) and dist(m) < O.collectSafe then return end
		local root = myRoot()
		if not root then return end
		local best, bd
		for _, c in ipairs(listCoins()) do
			if not Collect.visited[c] then
				local d = (c.Position - root.Position).Magnitude
				if not bd or d < bd then best, bd = c, d end
			end
		end
		if not best then return end
		Collect.busy = true
		task.spawn(function()
			pcall(function()
				moveTo(best.Position, O.collectSpeed)
				task.wait(0.15)
			end)
			Collect.visited[best] = true
			Collect.busy = false
		end)
	end)
	return true
end, function()
	Sched.remove("collect")
	Collect.busy = false
	NC.release("collect")
end)

