local ESP = { objs = {}, gun = nil }
local ESPNames = { "PlayerESP", "HeroESP", "MurdererESP", "SheriffESP" }

local function shouldShow(role)
	if Features.PlayerESP.on then return true end
	if role == "Murderer" then return Features.MurdererESP.on end
	if role == "Sheriff" then return Features.SheriffESP.on end
	if role == "Hero" then return Features.HeroESP.on end
	return false
end
function ESP.create(p, c, root)
	local hl = new("Highlight", { Adornee = c, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = ESPFolder })
	local bb = new("BillboardGui", { Adornee = root, AlwaysOnTop = true, Size = UDim2.fromOffset(240, 22), StudsOffset = Vector3.new(0, 3.4, 0), Parent = ESPFolder })
	local label = text(bb, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold, TextSize = 13, TextStrokeTransparency = 0.4 })
	local box = new("SelectionBox", { Adornee = c, LineThickness = 0.04, SurfaceTransparency = 1, Visible = false, Parent = ESPFolder })
	local line
	if CAP.drawing then
		local ok, l = pcall(function()
			local d = Drawing.new("Line")
			d.Visible = false; d.Thickness = 1.5; d.Transparency = 1
			return d
		end)
		if ok then line = l end
	end
	return { char = c, root = root, hl = hl, bb = bb, label = label, box = box, line = line, color = Color3.new(1, 1, 1) }
end
function ESP.destroyObj(p)
	local o = ESP.objs[p]
	if not o then return end
	ESP.objs[p] = nil
	pcall(function() o.hl:Destroy(); o.bb:Destroy(); o.box:Destroy() end)
	if o.line then pcall(function() o.line:Remove() end) end
end
function ESP.clearAll()
	for p in pairs(ESP.objs) do ESP.destroyObj(p) end
end
function ESP.hideTracers()
	for _, o in pairs(ESP.objs) do if o.line then o.line.Visible = false end end
end
function ESP.update()
	local seen = {}
	local me = myRoot()
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local role = getRole(p)
			local c = p.Character
			local root = rootOf(p)
			if root and isAlive(p) and shouldShow(role) and (not me or (me.Position - root.Position).Magnitude <= O.espMaxDist) then
				seen[p] = true
				local o = ESP.objs[p]
				if not o or o.char ~= c then
					ESP.destroyObj(p)
					o = ESP.create(p, c, root)
					ESP.objs[p] = o
				end
				local col = Config.colors[role] or Config.colors.Innocent
				o.color = col
				o.hl.FillColor = col; o.hl.OutlineColor = col
				o.hl.FillTransparency = O.espFill; o.hl.OutlineTransparency = O.espOutline
				local parts = {}
				if O.espName then parts[#parts + 1] = p.DisplayName end
				if O.espRole and role ~= "Lobby" then parts[#parts + 1] = role end
				if O.espDist and me then parts[#parts + 1] = string.format("%.0fm", (me.Position - root.Position).Magnitude) end
				if O.espHealth then
					local h = c:FindFirstChildOfClass("Humanoid")
					if h then parts[#parts + 1] = string.format("%.0fHP", h.Health) end
				end
				o.label.Text = table.concat(parts, " | ")
				o.label.TextColor3 = col
				o.bb.Enabled = #parts > 0
				o.box.Visible = O.espBox
				o.box.Color3 = col
			end
		end
	end
	for p in pairs(ESP.objs) do if not seen[p] then ESP.destroyObj(p) end end
end
function ESP.tracers()
	local cam = Workspace.CurrentCamera
	local vp = cam.ViewportSize
	local from = Vector2.new(vp.X / 2, vp.Y)
	for _, o in pairs(ESP.objs) do
		if o.line then
			if O.espTracer and o.root and o.root.Parent then
				local pos, on = cam:WorldToViewportPoint(o.root.Position)
				if on then
					o.line.From = from; o.line.To = Vector2.new(pos.X, pos.Y); o.line.Color = o.color; o.line.Visible = true
				else
					o.line.Visible = false
				end
			else
				o.line.Visible = false
			end
		end
	end
end
function ESP.anyOn()
	for _, n in ipairs(ESPNames) do if Features[n] and Features[n].on then return true end end
	return false
end
function ESP.refreshTask()
	if ESP.anyOn() then
		if not Sched.has("esp") then Sched.add("esp", O.espInterval, ESP.update) end
		if O.espTracer and CAP.drawing then
			if not Sched.has("tracers") then Sched.add("tracers", 0, ESP.tracers) end
		else
			Sched.remove("tracers"); ESP.hideTracers()
		end
	else
		Sched.remove("esp"); Sched.remove("tracers"); ESP.clearAll()
	end
end
function ESP.clearGun()
	if ESP.gun then
		pcall(function() ESP.gun.hl:Destroy(); ESP.gun.bb:Destroy() end)
		ESP.gun = nil
	end
end
function ESP.updateGun()
	local drop = Workspace:FindFirstChild("GunDrop")
	local part = drop and (drop:IsA("BasePart") and drop or drop:FindFirstChildWhichIsA("BasePart", true))
	if not part then ESP.clearGun() return end
	if not ESP.gun or ESP.gun.part ~= part then
		ESP.clearGun()
		local hl = new("Highlight", { Adornee = drop, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, FillTransparency = 0.4, Parent = ESPFolder })
