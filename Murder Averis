		local c = a < 0.04 and Color3.new(1, 1, 1) or Color3.fromHSV((a - 0.04) / 0.96, 0.85, 1)
		Config.colors[key] = c
		show()
		if onChange then onChange(c) end
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			local function upd(x) apply(math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)) end
			upd(i.Position.X)
			Drag.fn = upd
		end
