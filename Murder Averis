local grabbing, lastGrab = false, 0
local function grabGun()
	if grabbing then return end
	local drop = Workspace:FindFirstChild("GunDrop")
	if not drop then notify("Arma", "No hay arma caída.") return end
	if Roles[LocalPlayer] == "Murderer" then notify("Arma", "El Murderer no puede recoger el arma.") return end
	local root = myRoot()
	if not root or not isAlive(LocalPlayer) then return end
	local part = drop:IsA("BasePart") and drop or drop:FindFirstChildWhichIsA("BasePart", true)
	if not part then return end
	grabbing = true
	lastGrab = tick()
	local back = root.CFrame
	pcall(function()
		root.CFrame = part.CFrame + Vector3.new(0, 1.5, 0)
		if CAP.touch then
			pcall(firetouchinterest, root, part, 0)
			task.wait()
			pcall(firetouchinterest, root, part, 1)
		end
		task.wait(0.45)
	end)
	local r2 = myRoot()
	if r2 then r2.CFrame = back; zeroVel(r2) end
	grabbing = false
