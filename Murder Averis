local function Slider(page, label, key, min, max, step, onChange)
	local r = Row(page, 48)
	text(r, { Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -90, 0, 20), Text = label, Font = Enum.Font.GothamSemibold })
	local val = text(r, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 4), Size = UDim2.fromOffset(70, 20), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = C.accent, TextSize = 12, Font = Enum.Font.GothamBold })
	local hit = new("TextButton", { Position = UDim2.fromOffset(12, 26), Size = UDim2.new(1, -24, 0, 18), Text = "", BackgroundTransparency = 1, Parent = r })
	local track = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = C.off, BorderSizePixel = 0, Parent = hit })
	corner(track, 3)
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.accent, BorderSizePixel = 0, Parent = track })
	corner(fill, 3)
	local knob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1), Parent = fill })
	corner(knob, 6)
	local function show()
		local v = O[key]
		fill.Size = UDim2.fromScale(math.clamp((v - min) / (max - min), 0, 1), 1)
		val.Text = step >= 1 and string.format("%.0f", v) or string.format("%.2f", v)
	end
	local function setv(v, fire)
		v = math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max)
		v = tonumber(string.format("%.4f", v))
		O[key] = v
		show()
		if fire and onChange then onChange(v) end
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			local function upd(x)
				setv(min + (max - min) * math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1), true)
			end
			upd(i.Position.X)
			Drag.fn = upd
		end
	end)
	Controls[key] = show
	show()
end

