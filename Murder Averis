Janitor.add(Players.PlayerAdded:Connect(function() task.defer(refreshPickers) end))
Janitor.add(Players.PlayerRemoving:Connect(function(p)
	Roles[p] = nil
	ESP.destroyObj(p)
	if State.selected == p then State.selected = nil end
	if State.spectating == p then unspectate() end
	task.defer(refreshPickers)
end))
Janitor.add(LocalPlayer.CharacterAdded:Connect(function(char)
	task.spawn(function()
		char:WaitForChild("HumanoidRootPart", 10)
		char:WaitForChild("Humanoid", 10)
		local list = {}
		for name, f in pairs(Features) do if f.on and f.restart then list[#list + 1] = name end end
		for _, n in ipairs(list) do pcall(Features[n].stop) end
		Orig = {}
		if NC.count > 0 then NC.collect() end
		for _, n in ipairs(list) do
			local f = Features[n]
			local ok, res = pcall(f.start)
			if not ok or res == false then
				f.on = false
				if f.ui then f.ui(false) end
			end
		end
	end)
end))

