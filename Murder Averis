-- Registro de funciones
--------------------------------------------------------------------
local Features = {}
local function defineFeature(name, start, stop, opts)
	Features[name] = { on = false, start = start, stop = stop or function() end, restart = opts and opts.restart }
end
local function setFeature(name, on)
	local f = Features[name]
	if not f then return end
	on = on and true or false
	if f.on == on then if f.ui then f.ui(on) end return end
	if on then
		f.on = true
		local ok, res = pcall(f.start)
		if not ok or res == false then
			f.on = false
			if not ok then warn("[AVERIS] " .. name .. ": " .. tostring(res)) end
			notify(name, "No se pudo activar (personaje o condiciones no disponibles).")
		end
	else
		f.on = false
		local ok, err = pcall(f.stop)
		if not ok then warn("[AVERIS] stop " .. name .. ": " .. tostring(err)) end
	end
	if f.ui then f.ui(f.on) end
end

--------------------------------------------------------------------
-- Detección de ronda y roles (por herramientas Knife / Gun)
--------------------------------------------------------------------
refreshRoles = function()
	local quiet = Round.first
	Round.first = false
	local murd, holder
	for _, p in ipairs(Players:GetPlayers()) do
		if hasTool(p, "Knife") then murd = p end
		if hasTool(p, "Gun") then holder = p end
	end
	local nowActive = murd ~= nil
	local changed = nowActive ~= Round.active
	if nowActive and not Round.active then
		Round.origSheriff = nil; Round.gunDropped = false; Round.holder = nil; Round.lastMurd = nil
		if O.alertRound and not quiet then notify("Ronda", "La ronda ha comenzado") end
	elseif Round.active and not nowActive then
		Round.origSheriff = nil; Round.gunDropped = false; Round.holder = nil; Round.lastMurd = nil
		if O.alertRound and not quiet then notify("Ronda", "La ronda ha terminado") end
	end
	Round.active = nowActive
	Round.murderer = murd
	if nowActive then
		if murd and murd ~= Round.lastMurd then
			Round.lastMurd = murd
			if O.alertMurderer and not quiet then notify("Murderer", murd.DisplayName .. " (@" .. murd.Name .. ")") end
		end
		if holder and not Round.origSheriff then
			Round.origSheriff = holder
			if O.alertSheriff and not quiet then notify("Sheriff", holder.DisplayName .. " (@" .. holder.Name .. ")") end
		end
		local prev = Round.holder
		if prev ~= holder then
			if holder == nil and prev ~= nil then
				Round.gunDropped = true
				if O.alertGun and not quiet then notify("Arma", "El arma fue soltada o perdida") end
			elseif holder ~= nil and Round.gunDropped then
				Round.gunDropped = false
				if O.alertGun and not quiet then notify("Arma", holder.DisplayName .. " recogió el arma") end
			end
		end
		Round.holder = holder
	end
	for _, p in ipairs(Players:GetPlayers()) do
		local r = "Innocent"
		if not nowActive then r = "Lobby"
		elseif p == murd then r = "Murderer"
		elseif p == holder then r = (p == Round.origSheriff) and "Sheriff" or "Hero" end
		Roles[p] = r
	end
	if changed and refreshPickers then task.defer(refreshPickers) end
end

