local function tween(o, t, goal)
	local tw = TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = o }) end
local function stroke(o, col, th, tr) return new("UIStroke", { Color = col or C.accent, Thickness = th or 1, Transparency = tr or 0, Parent = o }) end
local function text(parent, props)
