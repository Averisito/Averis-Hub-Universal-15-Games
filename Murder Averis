local function myChar() return LocalPlayer.Character end
local function myHum() local c = LocalPlayer.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function myRoot() local c = LocalPlayer.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function rootOf(p) local c = p.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function isAlive(p)
	local c = p.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	return (h ~= nil and h.Health > 0 and c:FindFirstChild("HumanoidRootPart") ~= nil)
end
local function isIgnored(p) return Config.ignored[p.UserId] == true end
local function dist(p)
	local a, b = myRoot(), rootOf(p)
	if a and b then return (a.Position - b.Position).Magnitude end
	return math.huge
end
local function getRole(p) return Roles[p] or "Lobby" end
local function hasTool(p, name)
	local c = p.Character
	if c and c:FindFirstChild(name) then return true end
	local b = p:FindFirstChildOfClass("Backpack")
	return b ~= nil and b:FindFirstChild(name) ~= nil
end
local function getTool(name, equip)
	local c = LocalPlayer.Character
	if not c then return nil end
	local t = c:FindFirstChild(name)
	if t then return t end
	local b = LocalPlayer:FindFirstChildOfClass("Backpack")
	t = b and b:FindFirstChild(name)
	if t and equip then
		local h = myHum()
		if h then pcall(function() h:EquipTool(t) end) end
	end
	return t
end
local function zeroVel(r)
	if r then r.AssemblyLinearVelocity = Vector3.zero; r.AssemblyAngularVelocity = Vector3.zero end
end
local function visible(pos, targetChar)
	local cam = Workspace.CurrentCamera
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character, targetChar, cam }
	local origin = cam.CFrame.Position
	return Workspace:Raycast(origin, pos - origin, params) == nil
end
local function copyText(s)
