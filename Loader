-- Petición HTTP usando la función del executor; si no existe, HttpService:RequestAsync
function Http.Request(opciones)
	local fn = (syn and syn.request) or request or http_request or (http and http.request)
	if fn then
		return fn(opciones)
	end
	return HttpService:RequestAsync(opciones)
end

-- Descarga texto de una URL
function Http.Get(url)
	local ok, cuerpo = pcall(function()
		return game:HttpGet(url)
	end)
	if ok and type(cuerpo) == "string" then
		return cuerpo
	end
	local ok2, resp = pcall(Http.Request, { Url = url, Method = "GET" })
	if ok2 and resp and resp.Body then
		return resp.Body
	end
	return nil
end

-- Copia al portapapeles (devuelve true si el executor lo soporta)
function Deteccion.Copiar(texto)
	if not setclipboard then
		return false
	end
	return (pcall(setclipboard, texto))
end

-- Formatea números con separador de miles: 13168 → 13,168
function Deteccion.Formato(n)
	local s = tostring(math.floor(tonumber(n) or 0))
	local invertido = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if invertido:sub(1, 1) == "," then
		invertido = invertido:sub(2)
	end
	return invertido
end

-- Nombre del executor
function Deteccion.Executor()
	local nombre = "Unknown"
	if identifyexecutor then
		local ok, n, v = pcall(identifyexecutor)
		if ok and n then
			nombre = tostring(n)
			if v then
				nombre = nombre .. " " .. tostring(v)
			end
		end
	end
	return nombre
end

