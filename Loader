		Name = "AverisSplashLogo",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = CONFIG.ORDEN_LOGO,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
