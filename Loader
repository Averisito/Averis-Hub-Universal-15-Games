	local contadorToast = 0

	function api.Toast(mensaje, tipo, duracion)
		if not notificaciones and tipo ~= "error" then
			return
		end
		local colores = { ok = COLORES.verde, error = COLORES.rojo, warn = COLORES.ambar }
		local color = colores[tipo or ""] or COLORES.morado
		contadorToast = contadorToast + 1

		local envoltorio = Util.Crear("Frame", {
			Size = UDim2.fromOffset(290, 46), BackgroundTransparency = 1, LayoutOrder = contadorToast,
		}, contenedorToast)
		local tarjetaToast = Util.Crear("Frame", {
			Position = UDim2.fromOffset(330, 0), Size = UDim2.fromOffset(290, 46),
			BackgroundColor3 = COLORES.panel, BorderSizePixel = 0,
		}, envoltorio)
		redondear(tarjetaToast, 10)
		borde(tarjetaToast, COLORES.borde, 1)
		marco(tarjetaToast, 0, 9, 3, 28, color, 2)
		etiqueta(tarjetaToast, {
			Text = mensaje, TextSize = 12, TextColor3 = COLORES.texto, TextWrapped = true,
			Position = UDim2.fromOffset(16, 0), Size = UDim2.fromOffset(266, 46),
		})
		Util.Tween(tarjetaToast, 0.4, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

		task.delay(duracion or 3.2, function()
			if not tarjetaToast.Parent then
				return
			end
			local salida = Util.Tween(tarjetaToast, 0.35, { Position = UDim2.fromOffset(330, 0) },
				Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			salida.Completed:Wait()
			envoltorio:Destroy()
		end)
	end

	-- ═════════ API PÚBLICA ═════════

	api.Gui = gui
	api.BotonCargar = btnCargar

	function api.ObtenerKey()
		return keyReal
	end

	function api.PonerKey(key)
		keyReal = key or ""
		refrescarVista()
	end

	-- tipo: "ok" | "error" | "warn" | "info"
	function api.Estado(tipo, mensaje)
		local color = COLORES.moradoClaro
		if tipo == "ok" then
			color = COLORES.verde
		elseif tipo == "error" then
			color = COLORES.rojo
		elseif tipo == "warn" then
			color = COLORES.ambar
		end
		Util.Tween(badgeEstado, 0.25, { BackgroundColor3 = color:Lerp(COLORES.tarjeta, 0.85) }, Enum.EasingStyle.Sine)
		Util.Tween(lblEstado, 0.25, { TextColor3 = color }, Enum.EasingStyle.Sine)
		lblEstado.Text = mensaje
	end

	function api.Intentos(n)
		lblIntentos.Text = n .. " / " .. CONFIG.MAX_INTENTOS .. " tries"
		Util.Tween(lblIntentos, 0.2, {
			TextColor3 = (n >= CONFIG.MAX_INTENTOS - 1 and n > 0) and COLORES.rojo or COLORES.gris,
		}, Enum.EasingStyle.Sine)
	end

	function api.Hint(mensaje)
		lblHint.Text = "ⓘ  " .. mensaje
	end

	-- Bloquea el botón con un texto (cooldown / cargando); nil lo restaura
	function api.BloquearBoton(mensaje)
		if mensaje then
			btnCargar.Text = mensaje
			btnCargar.Active = false
			btnCargar.AutoButtonColor = false
			Util.Tween(btnCargar, 0.2, { BackgroundTransparency = 0.45 }, Enum.EasingStyle.Sine)
		else
			btnCargar.Text = "⚡  Load script"
			btnCargar.Active = true
			Util.Tween(btnCargar, 0.2, { BackgroundTransparency = 0 }, Enum.EasingStyle.Sine)
		end
	end

	function api.ActualizarJuego(info)
		lblJuego.Text = info.nombre
		miniatura.Image = info.icono
		rellenarInsignias(info)
		lblPlace.Text = tostring(info.placeId)
	end

	function api.ActualizarDiscord(online, miembros)
		lblOnline.Text = Deteccion.Formato(online) .. " online"
		lblMiembros.Text = "👥 " .. Deteccion.Formato(miembros) .. " members"
	end

	-- Posición absoluta y escala final del logo en la cabecera (para el vuelo del splash)
	function api.ObtenerDestino()
		local v = Util.Viewport()
		local centro = v / 2 + (SLOT_LOGO - Vector2.new(PN.W, PN.H) / 2) * escala
		return centro, ESCALA_LOGO_CAB * escala
	end

	-- El splash entrega el logo: se instala en la cabecera
	function api.AdoptarLogo(grupo)
		velo.BackgroundTransparency = 0.45
		velo.Active = true
		grupo.Parent = cab
		grupo.AnchorPoint = Vector2.new(0.5, 0.5)
		grupo.Position = UDim2.fromOffset(SLOT_LOGO.X, SLOT_LOGO.Y)
		local esc = grupo:FindFirstChild("Escala")
		if esc then
			esc.Scale = ESCALA_LOGO_CAB
		end
		local brillo = grupo:FindFirstChild("Glow")
		if brillo then
			Util.Tween(brillo, 0.8, { ImageTransparency = 0.8 }, Enum.EasingStyle.Sine)
		end
	end

	-- Scale-in 0.92→1 + fade + sombras que se intensifican
	function api.Mostrar()
		gui.Parent = Util.PadreGui()
		guiToast.Parent = Util.PadreGui()
		Util.Tween(escalaRaiz, 0.7, { Scale = escala }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		Util.Tween(ventana, 0.6, { GroupTransparency = 0 }, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
		for i, s in ipairs(sombras) do
			task.delay((i - 1) * 0.06, function()
				Util.Tween(s.obj, 0.8, { BackgroundTransparency = s.destino }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			end)
		end
	end

	function api.Cerrar()
		if cerrado then
			return
		end
		cerrado = true
		for _, c in ipairs(conexiones) do
			pcall(function()
				c:Disconnect()
			end)
		end
		Util.Tween(escalaRaiz, 0.35, { Scale = escala * 0.92 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Util.Tween(ventana, 0.3, { GroupTransparency = 1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		for _, s in ipairs(sombras) do
			Util.Tween(s.obj, 0.3, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
		end
		Util.Tween(velo, 0.4, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
		task.delay(0.5, function()
			gui:Destroy()
			if api.AlCerrar then
				api.AlCerrar()
			end
		end)
		task.delay(5, function()
			guiToast:Destroy()
		end)
	end

	-- Eventos de los botones → callbacks del controlador
	btnCerrar.MouseButton1Click:Connect(function()
		api.Cerrar()
	end)
	btnCargar.MouseButton1Click:Connect(function()
		if btnCargar.Active and api.AlCargar then
