-- Paso 2: los palitos entran desde el borde izquierdo en cascada
local function entradaLogo(logo)
	Util.Tween(logo.glow, 0.8, { ImageTransparency = 0.6 }, Enum.EasingStyle.Sine)

	for i, b in ipairs(logo.barras) do
		task.delay((i - 1) * 0.08, function()
			local p = posLlegada(b.def)
			Util.Tween(b.obj, 0.7, { Position = UDim2.fromOffset(p.X, p.Y) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end)
	end
	task.wait(0.7 + (#logo.barras - 1) * 0.08 + 0.05)

	-- El glow empieza a pulsar suavemente
	logo.pulso = TweenService:Create(
		logo.glow,
		TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ ImageTransparency = 0.45 }
	)
	logo.pulso:Play()
end

-- Paso 3a: ensamblado de la "A" con micro rebote
local function ensamblarLogo(logo)
	for _, b in ipairs(logo.barras) do
		Util.Tween(b.obj, 0.6, {
			Position = UDim2.fromOffset(CENTRO_LOGO.X + b.def.x, CENTRO_LOGO.Y + b.def.y),
			Rotation = b.def.rot,
		}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	task.wait(0.65)
end

-- Paso 3b: letras una a una + aparece la barra de progreso
local function entradaNombre(nombre, prog)
	for i, l in ipairs(nombre.letras) do
		task.delay((i - 1) * 0.07, function()
			Util.Tween(l.obj, 0.5, {
				TextTransparency = 0,
				Position = UDim2.fromOffset(l.x, 0),
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		end)
	end
	task.wait((#nombre.letras - 1) * 0.07 + 0.4)

	Util.Tween(prog.fondo, 0.4, { BackgroundTransparency = 0 }, Enum.EasingStyle.Sine)
	Util.Tween(prog.izq, 0.4, { TextTransparency = 0 }, Enum.EasingStyle.Sine)
	Util.Tween(prog.pct, 0.4, { TextTransparency = 0 }, Enum.EasingStyle.Sine)
	task.wait(0.4)
end

-- Paso 4: puntos aparecen desde el centro y luego "respiran" en loop (no bloquea)
local function entradaPuntos(puntos, centro)
	task.spawn(function()
		local maxRetardo = 0
		for _, d in ipairs(puntos) do
			maxRetardo = math.max(maxRetardo, d.retardo)
			task.delay(d.retardo, function()
				Util.Tween(d.obj, 0.5, { BackgroundTransparency = 0.7 }, Enum.EasingStyle.Sine)
			end)
		end
		task.wait(maxRetardo + 0.55)

		-- Respiración: expande hasta 1.25x mientras se desvanece y vuelve (Sine.InOut, sin saltos)
		for _, d in ipairs(puntos) do
			local destino = centro + (d.base - centro) * 1.25
			d.tween = TweenService:Create(
				d.obj,
				TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, d.retardo),
				{
					Position = UDim2.fromOffset(destino.X, destino.Y),
					BackgroundTransparency = 0.93,
				}
			)
			d.tween:Play()
		end
	end)
end

-- Paso 5: progreso simulado con porcentaje sincronizado frame a frame
local function correrProgreso(prog)
	local conexion = RunService.RenderStepped:Connect(function()
		prog.pct.Text = math.floor(prog.fill.Size.X.Scale * 100 + 0.5) .. "%"
	end)

	for _, paso in ipairs(CONFIG.Splash.Pasos) do
		if CONFIG.Splash.MostrarMensajes then
			prog.izq.Text = paso.texto
		end
		Util.Tween(prog.fill, CONFIG.Splash.DuracionPaso, {
			Size = UDim2.fromScale(paso.pct / 100, 1),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.wait(CONFIG.Splash.DuracionPaso)
	end

	conexion:Disconnect()
	prog.pct.Text = "100%"
end

-- Paso 6: transición al panel
local function transicion(estado)
	local fondo, logo, nombre, prog = estado.fondo, estado.logo, estado.nombre, estado.prog
	local puntos, centro, escala, hooks = estado.puntos, estado.centro, estado.escala, estado.hooks

	-- 1) Fondo: de opaco a transparente (se ve el juego detrás, gris oscuro)
	Util.Tween(fondo, 0.9, {
		BackgroundTransparency = 0.45,
		BackgroundColor3 = COLORES.fondoVelo,
	}, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

	-- 2) Última expansión grande de los puntos y desaparecen
	for _, d in ipairs(puntos) do
		if d.tween then
			d.tween:Cancel()
		end
		local destino = centro + (d.base - centro) * 2.8
		Util.Tween(d.obj, 0.9, {
			Position = UDim2.fromOffset(destino.X, destino.Y),
			BackgroundTransparency = 1,
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end

	-- 3) "AVERIS" y progreso: fade out con slide sutil hacia arriba
	for _, l in ipairs(nombre.letras) do
		Util.Tween(l.obj, 0.45, {
			TextTransparency = 1,
			Position = UDim2.fromOffset(l.x, -10),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end
	for _, o in ipairs({ prog.fondo, prog.fill }) do
		Util.Tween(o, 0.4, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
	end
	for _, o in ipairs({ prog.izq, prog.pct }) do
		Util.Tween(o, 0.4, { TextTransparency = 1 }, Enum.EasingStyle.Sine)
	end
	if logo.pulso then
		logo.pulso:Cancel()
	end
	Util.Tween(logo.glow, 0.5, { ImageTransparency = 1 }, Enum.EasingStyle.Sine)

	-- 4) El logo pasa a una capa superior conservando su posición absoluta
	local grupo = logo.grupo
	local centroAbs = grupo.AbsolutePosition + grupo.AbsoluteSize / 2
	local capaLogo = Util.Crear("Frame", {
		Name = "CapaLogo",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}, estado.guiLogo)
	grupo.Parent = capaLogo
	grupo.Position = UDim2.fromOffset(centroAbs.X, centroAbs.Y)
	logo.escala.Scale = escala

	-- Destino: slot del logo en la cabecera del panel
	local vp = estado.vp
	local destPos = Vector2.new(vp.X / 2 - 315 * escala, vp.Y / 2 - 185 * escala)
	local destEsc = 0.45 * escala
	if hooks.obtenerDestino then
		destPos, destEsc = hooks.obtenerDestino()
	end

	-- 5) El panel aparece a la vez (scale-in + fade + sombra)
	if hooks.mostrarPanel then
		hooks.mostrarPanel()
	end

	-- 6) Vuelo en curva tipo Bézier cuadrática, con easing Quad.InOut sobre el parámetro t
	local p0 = centroAbs
	local p2 = destPos
	local p1 = Vector2.new(p2.X, p0.Y) -- punto de control: primero va hacia la izquierda y luego sube
	local valor = Util.Crear("NumberValue", { Value = 0 })
	local conexion = valor.Changed:Connect(function(t)
		local u = 1 - t
		local p = p0 * (u * u) + p1 * (2 * u * t) + p2 * (t * t)
		grupo.Position = UDim2.fromOffset(p.X, p.Y)
		logo.escala.Scale = escala + (destEsc - escala) * t
	end)
	local vuelo = TweenService:Create(valor, TweenInfo.new(1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { Value = 1 })
	vuelo:Play()
	vuelo.Completed:Wait()
	conexion:Disconnect()
	valor:Destroy()

	-- 7) Entrega del logo al panel (o se destruye si no hay panel)
	if hooks.alTerminar then
		hooks.alTerminar(grupo)
	else
		grupo:Destroy()
	end
end

