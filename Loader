-- Rejilla de puntos (empiezan invisibles)
local function crearPuntos(padre, centro)
	local lista = {}
	local cols, filas, esp = 13, 11, 22
	local mitadC, mitadF = (cols - 1) / 2, (filas - 1) / 2
	local maxDist = math.sqrt(mitadC ^ 2 + mitadF ^ 2) * esp

	for c = 0, cols - 1 do
		for f = 0, filas - 1 do
			local base = Vector2.new(centro.X + (c - mitadC) * esp, centro.Y + (f - mitadF) * esp)
			local obj = Util.Crear("Frame", {
				Name = "Punto",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(2, 2),
				Position = UDim2.fromOffset(base.X, base.Y),
				BackgroundColor3 = COLORES.punto,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 1,
			}, padre)
			table.insert(lista, {
				obj = obj,
				base = base,
				retardo = ((base - centro).Magnitude / maxDist) * 0.8, -- de adentro hacia afuera
				tween = nil,
			})
		end
	end
	return lista
end

