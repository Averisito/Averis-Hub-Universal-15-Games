	-- ═════════ TOASTS (abajo-derecha, slide-in/out) ═════════
	local contenedorToast = Util.Crear("Frame", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.fromOffset(290, 420), BackgroundTransparency = 1,
