-- ═══════════════════════════════════════════════════════════
-- BLOQUE F · CONTROLADOR Y ARRANQUE
-- Conecta Splash + Panel + KeySystem + Detección
-- ═══════════════════════════════════════════════════════════
local function liberarLoader()
	genv.AVERIS_LOADER_ACTIVO = nil
end

local function iniciar()
	local sesion = nil
	local juego = nil
	local panel = nil
	local listo = false
	local autoPorJuego = CONFIG.AUTO_BY_GAME
	local cargando = false
	local cooldownActivo = false

	-- Detección + construcción del panel en paralelo mientras corre el splash
	local fallo = nil
	task.spawn(function()
		local ok, res = pcall(function()
			sesion = Deteccion.Sesion()
			juego = Deteccion.Juego()
			panel = Panel.Crear(sesion, juego)
		end)
		if ok then
			listo = true
		else
			fallo = tostring(res)
		end
	end)

	-- Cuenta atrás del cooldown en el propio botón
	local function iniciarCooldown()
		if cooldownActivo then
			return
		end
		cooldownActivo = true
		panel.Estado("error", "✕ Locked")
		task.spawn(function()
			while true do
				local enCooldown, resto = KeySystem.EnCooldown()
				if not enCooldown then
					break
				end
				panel.BloquearBoton("Wait " .. resto .. "s")
				task.wait(0.25)
			end
			KeySystem.Reiniciar()
			panel.Intentos(0)
			panel.BloquearBoton(nil)
			panel.Estado("info", "Enter your key")
			cooldownActivo = false
		end)
	end

	-- Ejecuta el script correcto (por juego o universal)
	local function ejecutarScript()
		local url, porJuego = Deteccion.ScriptParaJuego(autoPorJuego)
		local codigo = Http.Get(url)
		if not codigo or codigo == "" then
			panel.Toast("Could not download the script", "error")
			panel.BloquearBoton(nil)
			cargando = false
			return
		end
		local fn, errCompilar = loadstring(codigo)
		if not fn then
			panel.Toast("The script has an error: " .. tostring(errCompilar), "error", 4)
			panel.BloquearBoton(nil)
			cargando = false
			return
		end
		panel.Toast(porJuego and ("Loading " .. juego.nombre .. "...") or "Loading universal script...", "ok")
		task.wait(0.4)
		panel.Cerrar()
		task.spawn(function()
			local ok, err = pcall(fn)
			if not ok then
				warn("[AVERIS] " .. tostring(err))
			end
		end)
	end

	-- Flujo de "Load script": valida la key (o salta si KEYLESS) y ejecuta
	local function cargarScript()
		if cargando then
			return
		end

		if not CONFIG.KEYLESS then
			local enCooldown, resto = KeySystem.EnCooldown()
			if enCooldown then
				panel.Toast("Too many attempts. Wait " .. resto .. "s", "warn")
				return
			end
			local key = panel.ObtenerKey()
			if key == "" then
				panel.Estado("warn", "Key required")
				panel.Toast("Enter your access key first", "warn")
				return
			end

			cargando = true
			panel.BloquearBoton("Verifying...")
			panel.Estado("info", "Verifying...")
			local resultado = KeySystem.Verify(key)

			if not resultado.valid then
				local intentos, bloqueado = KeySystem.RegistrarFallo()
				panel.Intentos(intentos)
				panel.Estado("error", "✕ Invalid key")
				local motivo = resultado.reason ~= "" and resultado.reason or "Invalid key"
				panel.Toast(motivo .. " (" .. intentos .. "/" .. CONFIG.MAX_INTENTOS .. ")", "error")
				cargando = false
				if bloqueado then
					iniciarCooldown()
				else
					panel.BloquearBoton(nil)
				end
				return
			end

			KeySystem.Guardar(key, resultado.expires)
			KeySystem.Reiniciar()
			panel.Intentos(0)
		else
			cargando = true
		end

		panel.Estado("ok", "✓ Ready to load")
		panel.BloquearBoton("Loading...")
		ejecutarScript()
	end

	-- Conecta los callbacks del panel con la lógica y arranca la sesión
	local function conectarPanel()
		panel.AlCargar = cargarScript

		panel.AlAuto = function(valor)
			autoPorJuego = valor
			panel.Toast(valor and "Auto By Game: ON" or "Auto By Game: OFF (universal script)", "info", 2)
		end

		panel.AlGetKey = function()
			local copiado = Deteccion.Copiar(CONFIG.URL_GET_KEY)
			panel.Toast(copiado and "Key link copied. Open it in your browser" or CONFIG.URL_GET_KEY, "info", 4)
		end

		panel.AlDetectar = function()
			panel.Toast("Detecting game...", "info", 1.5)
			task.spawn(function()
				juego = Deteccion.Juego()
				panel.ActualizarJuego(juego)
				local _, porJuego = Deteccion.ScriptParaJuego(true)
				panel.Toast("Detected: " .. juego.nombre .. (porJuego and " · game script found" or " · using universal"), "ok", 3.5)
			end)
		end

		panel.AlDiscord = function()
			Deteccion.UnirseDiscord()
			panel.Toast("Invite copied. Opening Discord...", "ok", 3)
		end

		panel.AlBorrarKey = function()
			KeySystem.Borrar()
			panel.PonerKey("")
			panel.Estado("info", "Enter your key")
			panel.Hint("Saved key removed.")
			panel.Toast("Saved key removed", "ok")
		end

		panel.AlCerrar = function()
			liberarLoader()
		end

		-- Atajos de teclado: Right Shift cierra, Enter ejecuta
		panel.Conectar(UserInputService.InputBegan:Connect(function(input, procesado)
			if input.KeyCode == CONFIG.TECLA_CERRAR then
				panel.Cerrar()
			elseif (input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter)
				and not procesado and not UserInputService:GetFocusedTextBox() then
				cargarScript()
			end
		end))

		-- Estado inicial según KEYLESS o key guardada
		panel.Intentos(0)
		local keyGuardada = nil
		if CONFIG.KEYLESS then
			panel.Estado("ok", "✓ Ready to load")
			panel.Hint("Keyless mode: no key required. Press Enter or Load script.")
		else
			keyGuardada = KeySystem.Cargar()
			if keyGuardada then
				panel.PonerKey(keyGuardada) -- se muestra enmascarada: flow••••••••••55fb
				panel.Estado("ok", "✓ Ready to load")
				panel.Hint("Saved key loaded. Press Enter or Load script.")
			else
				panel.Estado("info", "Enter your key")
				panel.Hint("Paste your key and press Enter or Load script.")
			end
		end

		-- Datos reales del Discord (sin bloquear la interfaz)
		task.spawn(function()
			local online, miembros = Deteccion.DiscordStats()
			if online and panel.ActualizarDiscord then
				panel.ActualizarDiscord(online, miembros)
			end
		end)

		-- Toast de bienvenida con el nombre real del juego
		task.delay(0.9, function()
			panel.Toast("AVERIS | " .. juego.nombre .. " · [RightShift = close]", "info", 4)
		end)

		-- Auto By Game: con el toggle ON y key válida carga solo tras el splash
		if autoPorJuego and CONFIG.JUEGOS[game.PlaceId] and (CONFIG.KEYLESS or keyGuardada) then
			task.delay(2.2, function()
				if not cargando then
					panel.Toast("Auto-loading in a moment...", "info", 1.8)
					task.wait(1.4)
					cargarScript()
				end
			end)
		end
	end

	-- Hooks que usa el splash para entregar el control al panel
	local hooks = {
		obtenerDestino = function()
			while not listo do
				if fallo then
					error("No se pudo crear el panel: " .. fallo)
				end
				task.wait()
			end
			return panel.ObtenerDestino()
		end,
		mostrarPanel = function()
			panel.Mostrar()
		end,
		alTerminar = function(grupoLogo)
			panel.AdoptarLogo(grupoLogo)
			conectarPanel()
		end,
	}

	Splash.Run(hooks)
end

local ok, err = pcall(iniciar)
if not ok then
	liberarLoader()
	warn("[AVERIS] Error al iniciar: " .. tostring(err))
end
