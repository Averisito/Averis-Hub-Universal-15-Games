	hooks = hooks or {}
	local vp = Util.Viewport()
	local escala = Util.Escala(1280, 720, 2)

	-- Paso 1: ScreenGui a pantalla completa con fondo opaco
	local gui = Util.Crear("ScreenGui", {
		Name = "AverisSplash",
		ResetOnSpawn = false,
