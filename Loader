	local guiToast = Util.Crear("ScreenGui", {
		Name = "AverisToasts", ResetOnSpawn = false, IgnoreGuiInset = true,
		DisplayOrder = CONFIG.ORDEN_TOAST, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
