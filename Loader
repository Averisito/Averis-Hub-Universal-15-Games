			Name = "Letra" .. i,
			Text = texto:sub(i, i),
			Font = fuente,
			TextSize = SP.NOMBRE_TAM,
			TextColor3 = COLORES.texto,
			TextTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(hasta - previo + 4, 40),
			Position = UDim2.fromOffset(previo, 12), -- arranca 12px abajo (slide up)
			ZIndex = 3,
		}, marco)
		table.insert(letras, { obj = lbl, x = previo })
	end
	return { marco = marco, letras = letras }
