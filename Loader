local function crearLogo(padre, posicion, xInicio)
	local grupo = Util.Crear("Frame", {
		Name = "Logo",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(SP.LOGO.X, SP.LOGO.Y),
		Position = posicion,
		BackgroundTransparency = 1,
		ZIndex = 3,
	}, padre)
	local escala = Util.Crear("UIScale", { Name = "Escala", Scale = 1 }, grupo)

	-- Glow radial detrás de la A
	local glow = Util.Crear("ImageLabel", {
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(150, 150),
		Position = UDim2.fromOffset(CENTRO_LOGO.X, CENTRO_LOGO.Y),
		BackgroundTransparency = 1,
		Image = "rbxassetid://6015867271",
		ImageColor3 = COLORES.glow,
		ImageTransparency = 1,
		ZIndex = 3,
	}, grupo)

	local barras = {}
	for _, def in ipairs(BARRAS_A) do
		local obj = Util.Crear("Frame", {
			Name = def.nombre,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(def.ancho, def.alto),
			Position = UDim2.fromOffset(xInicio, CENTRO_LOGO.Y + def.y * 1.35),
			BackgroundColor3 = Color3.new(def.tono, def.tono, def.tono),
			BorderSizePixel = 0,
			ZIndex = 4,
		}, grupo)
		Util.Crear("UICorner", { CornerRadius = UDim.new(0, math.min(def.ancho, def.alto) / 2) }, obj)
		Util.Crear("UIGradient", { Color = GRADIENTE_PALITO, Rotation = 90 }, obj)
		table.insert(barras, { obj = obj, def = def })
	end

	return { grupo = grupo, escala = escala, glow = glow, barras = barras, pulso = nil }
end

-- Texto "AVERIS" separado por letras para animarlas una a una
local function crearNombre(padre, posicion, ancho)
	local fuente = Enum.Font.GothamBold
	local marco = Util.Crear("Frame", {
		Name = "Nombre",
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(ancho, 40),
		Position = posicion,
		BackgroundTransparency = 1,
		ZIndex = 3,
	}, padre)

	local letras = {}
	local texto = CONFIG.Nombre
	for i = 1, #texto do
		local previo = (i == 1) and 0 or Util.AnchoTexto(texto:sub(1, i - 1), SP.NOMBRE_TAM, fuente)
		local hasta = Util.AnchoTexto(texto:sub(1, i), SP.NOMBRE_TAM, fuente)
