-- BLOQUE D · KEY SYSTEM (KeySystem.lua)
-- ═══════════════════════════════════════════════════════════
local KeySystem = {
	intentos = 0,
	hasta = 0, -- os.time() hasta el que dura el cooldown
}

-- Hash estable de 64 bits (FNV-1a + djb2) en hexadecimal. No es criptográfico:
-- el servidor debe volver a validar todo (no confíes en el cliente).
function KeySystem.Hash(texto)
	local h1, h2 = 2166136261, 5381
	for i = 1, #texto do
		local b = texto:byte(i)
		h1 = bit32.bxor(h1, b)
		h1 = (h1 + bit32.lshift(h1, 1) + bit32.lshift(h1, 4) + bit32.lshift(h1, 7)
			+ bit32.lshift(h1, 8) + bit32.lshift(h1, 24)) % 4294967296
		h2 = (h2 * 33 + b) % 4294967296
	end
	return string.format("%08x%08x", h1, h2)
end

-- HWID: syn.request_gamehwid → gethwid → ClientId → hash estable guardado en getgenv
function KeySystem.GetHWID()
	local candidatos = {
		function() return syn and syn.request_gamehwid and syn.request_gamehwid() end,
		function() return gethwid and gethwid() end,
		function() return game:GetService("RbxAnalyticsService"):GetClientId() end,
	}
	for _, fn in ipairs(candidatos) do
		local ok, valor = pcall(fn)
		if ok and type(valor) == "string" and valor ~= "" then
			return valor
		end
	end
	if not genv.AVERIS_HWID then
		local semilla = tostring(Players.LocalPlayer.UserId) .. HttpService:GenerateGUID(false)
		genv.AVERIS_HWID = KeySystem.Hash(semilla)
	end
	return genv.AVERIS_HWID
end

-- Verifica la key contra el servidor. Devuelve { valid, expires, reason }
function KeySystem.Verify(key)
	if CONFIG.KEYLESS then
		return { valid = true, expires = 0, reason = "keyless" }
	end

	local cuerpo = HttpService:JSONEncode({
		key = KeySystem.Hash(key),
		hwid = KeySystem.GetHWID(),
		userid = Players.LocalPlayer.UserId,
		placeId = game.PlaceId,
	})

	local ok, resp = pcall(Http.Request, {
		Url = CONFIG.API_VERIFY,
		Method = "POST",
		Headers = { ["Content-Type"] = "application/json" },
		Body = cuerpo,
	})
	if not ok or not resp then
		return { valid = false, expires = 0, reason = "No connection to the auth server" }
	end

	local ok2, datos = pcall(function()
		return HttpService:JSONDecode(resp.Body or "")
	end)
	if not ok2 or type(datos) ~= "table" then
		return { valid = false, expires = 0, reason = "Invalid server response" }
	end

	return {
		valid = datos.valid == true,
		expires = tonumber(datos.expires) or 0,
		reason = tostring(datos.reason or ""),
	}
end

-- Persistencia: AverisHub/key.dat guarda key + expiración
function KeySystem.Guardar(key, expira)
	if not writefile then
		return false
	end
	local ok = pcall(function()
		if makefolder and isfolder and not isfolder("AverisHub") then
			makefolder("AverisHub")
		end
		writefile(CONFIG.ARCHIVO_KEY, HttpService:JSONEncode({ key = key, expira = expira or 0 }))
	end)
	return ok
end

-- Devuelve key, expira (o nil si no hay key guardada o ya caducó)
function KeySystem.Cargar()
	if not (isfile and readfile) then
		return nil
	end
	local ok, datos = pcall(function()
		if isfile(CONFIG.ARCHIVO_KEY) then
			return HttpService:JSONDecode(readfile(CONFIG.ARCHIVO_KEY))
		end
		return nil
	end)
	if ok and type(datos) == "table" and type(datos.key) == "string" and datos.key ~= "" then
		local expira = tonumber(datos.expira) or 0
		if expira > 0 and expira < os.time() then
			return nil
		end
		return datos.key, expira
	end
	return nil
end

function KeySystem.Borrar()
	pcall(function()
		if isfile and delfile and isfile(CONFIG.ARCHIVO_KEY) then
			delfile(CONFIG.ARCHIVO_KEY)
		end
	end)
end

-- "flowxxxxxxxxxxxx55fb" → "flow••••••••••55fb"
function KeySystem.Enmascarar(key)
	if #key <= 8 then
		return string.rep("•", #key)
	end
	return key:sub(1, 4) .. string.rep("•", math.min(#key - 8, 12)) .. key:sub(-4)
end

-- Cooldown y contador de intentos
function KeySystem.EnCooldown()
	local resto = KeySystem.hasta - os.time()
	return resto > 0, math.max(resto, 0)
end

-- Registra un fallo; devuelve intentos actuales y si se activó el cooldown
function KeySystem.RegistrarFallo()
	KeySystem.intentos = KeySystem.intentos + 1
	if KeySystem.intentos >= CONFIG.MAX_INTENTOS then
		KeySystem.hasta = os.time() + CONFIG.COOLDOWN
		return KeySystem.intentos, true
	end
	return KeySystem.intentos, false
end

function KeySystem.Reiniciar()
	KeySystem.intentos = 0
	KeySystem.hasta = 0
end

