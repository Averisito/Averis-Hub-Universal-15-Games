-- ───────────── Helpers de UI ─────────────

local function etiqueta(padre, props)
	local base = {
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = COLORES.gris,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Text = "",
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return Util.Crear("TextLabel", base, padre)
end

local function redondear(obj, radio)
	return Util.Crear("UICorner", { CornerRadius = UDim.new(0, radio) }, obj)
end

local function borde(obj, color, grosor)
	return Util.Crear("UIStroke", {
		Color = color or COLORES.bordeSuave,
		Thickness = grosor or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, obj)
end

local function marco(padre, x, y, w, h, color, radio)
	local f = Util.Crear("Frame", {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = color or COLORES.tarjeta,
		BorderSizePixel = 0,
	}, padre)
	if radio then
		redondear(f, radio)
	end
	return f
end

local function tarjeta(padre, x, y, w, h)
	local f = marco(padre, x, y, w, h, COLORES.tarjeta, 10)
	borde(f, COLORES.bordeSuave, 1)
	return f
end

-- Botón con hover (scale 1.03 + aclarado) y pulsación
local function boton(padre, x, y, w, h, contenido, colorBase, colorHover, opts)
	opts = opts or {}
	local b = Util.Crear("TextButton", {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = colorBase,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = contenido,
		Font = Enum.Font.GothamMedium,
		TextSize = opts.tam or 12,
		TextColor3 = opts.colorTexto or COLORES.texto,
	}, padre)
	redondear(b, opts.radio or 8)
	local escala = Util.Crear("UIScale", { Scale = 1 }, b)
	if opts.trazo then
		borde(b, opts.trazo, 1)
	end
	local brillo = nil
	if opts.glowColor then
		brillo = Util.Crear("UIStroke", {
			Color = opts.glowColor,
			Thickness = 2,
			Transparency = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, b)
	end

	b.MouseEnter:Connect(function()
		Util.Tween(escala, 0.18, { Scale = 1.03 }, Enum.EasingStyle.Sine)
		Util.Tween(b, 0.18, { BackgroundColor3 = colorHover }, Enum.EasingStyle.Sine)
		if opts.colorTextoHover then
			Util.Tween(b, 0.18, { TextColor3 = opts.colorTextoHover }, Enum.EasingStyle.Sine)
		end
		if brillo then
			Util.Tween(brillo, 0.25, { Transparency = 0.35 }, Enum.EasingStyle.Sine)
		end
	end)
	b.MouseLeave:Connect(function()
		Util.Tween(escala, 0.18, { Scale = 1 }, Enum.EasingStyle.Sine)
		Util.Tween(b, 0.18, { BackgroundColor3 = colorBase }, Enum.EasingStyle.Sine)
		if opts.colorTexto then
			Util.Tween(b, 0.18, { TextColor3 = opts.colorTexto }, Enum.EasingStyle.Sine)
		end
		if brillo then
			Util.Tween(brillo, 0.25, { Transparency = 1 }, Enum.EasingStyle.Sine)
		end
	end)
	b.MouseButton1Down:Connect(function()
		Util.Tween(escala, 0.08, { Scale = 0.97 }, Enum.EasingStyle.Sine)
	end)
	b.MouseButton1Up:Connect(function()
		Util.Tween(escala, 0.12, { Scale = 1.03 }, Enum.EasingStyle.Sine)
	end)

	return b
end

-- Interruptor tipo pill
local function interruptor(padre, x, y, inicial, alCambiar)
	local fondo = Util.Crear("TextButton", {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(34, 18),
		BackgroundColor3 = inicial and COLORES.morado or COLORES.barraFondo,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
	}, padre)
	redondear(fondo, 9)
	local perilla = Util.Crear("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, inicial and 19 or 3, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, fondo)
	redondear(perilla, 6)

	local estado = inicial
	local obj = {}
	function obj.Set(valor, silencioso)
		estado = valor
		Util.Tween(fondo, 0.2, { BackgroundColor3 = valor and COLORES.morado or COLORES.barraFondo }, Enum.EasingStyle.Sine)
		Util.Tween(perilla, 0.2, { Position = UDim2.new(0, valor and 19 or 3, 0.5, 0) }, Enum.EasingStyle.Back)
		if not silencioso and alCambiar then
			alCambiar(valor)
		end
	end
	function obj.Get()
		return estado
	end
	fondo.MouseButton1Click:Connect(function()
		obj.Set(not estado)
	end)
	return obj
end

-- Chip de atajo: [TECLA] descripción. Devuelve la X donde termina
local function chip(padre, x, y, tecla, descripcion)
	local ancho = Util.AnchoTexto(tecla, 9, Enum.Font.GothamBold) + 14
	local f = marco(padre, x, y, ancho, 20, COLORES.bordeSuave, 5)
	etiqueta(f, {
		Text = tecla, Font = Enum.Font.GothamBold, TextSize = 9, TextColor3 = COLORES.texto,
		TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1),
	})
	local anchoDesc = Util.AnchoTexto(descripcion, 11, Enum.Font.Gotham) + 6
	etiqueta(padre, {
		Text = descripcion, TextSize = 11,
		Position = UDim2.fromOffset(x + ancho + 8, y), Size = UDim2.fromOffset(anchoDesc, 20),
	})
	return x + ancho + 8 + anchoDesc + 12
end

