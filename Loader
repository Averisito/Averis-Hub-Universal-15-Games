local Util = {}

-- Crea una instancia, aplica propiedades y asigna el padre al final
function Util.Crear(clase, props, padre)
	local obj = Instance.new(clase)
	for k, v in pairs(props) do
		obj[k] = v
	end
	if padre then
		obj.Parent = padre
	end
	return obj
end

-- Padre seguro para los ScreenGui
function Util.PadreGui()
	local ok, resultado = pcall(function()
		if gethui then
			return gethui()
		end
		return game:GetService("CoreGui")
	end)
	if ok and resultado then
		return resultado
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

-- Tamaño de pantalla con fallback
function Util.Viewport()
	local ok, vp = pcall(function()
		return workspace.CurrentCamera.ViewportSize
	end)
	if ok and vp and vp.X > 0 then
		return vp
	end
	return Vector2.new(1280, 720)
end

-- Escala de UI según la resolución (PC grande o móvil pequeño)
function Util.Escala(refX, refY, maximo)
	local vp = Util.Viewport()
	return math.clamp(math.min(vp.X / refX, vp.Y / refY), 0.5, maximo or 2)
end

-- Tween rápido: lo reproduce y lo devuelve
function Util.Tween(obj, duracion, props, estilo, direccion)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(duracion, estilo or Enum.EasingStyle.Quad, direccion or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

-- Ancho en píxeles de un texto (con fallback si TextService falla)
function Util.AnchoTexto(texto, tam, fuente)
	if texto == "" then
		return 0
	end
	local ok, medida = pcall(function()
		return TextService:GetTextSize(texto, tam, fuente, Vector2.new(1000, 100))
	end)
	if ok and medida then
		return medida.X
	end
	return #texto * tam * 0.62
end

-- Aclara un color mezclándolo con blanco
function Util.Aclarar(color, cantidad)
	return color:Lerp(Color3.new(1, 1, 1), cantidad)
end

