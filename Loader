function Panel.Crear(sesion, juego)
	local api = {}
	local conexiones = {}
	local cerrado = false
	local notificaciones = true
	local vp = Util.Viewport()
	local escala = Util.Escala(1280, 720, 2)

	local function conectar(c)
		table.insert(conexiones, c)
		return c
	end
	api.Conectar = conectar

	-- ScreenGuis: panel y toasts (separados para que los toasts sobrevivan al cierre)
	local gui = Util.Crear("ScreenGui", {
		Name = "AverisPanel", ResetOnSpawn = false, IgnoreGuiInset = true,
		DisplayOrder = CONFIG.ORDEN_PANEL, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
