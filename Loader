	local escalaRaiz = Util.Crear("UIScale", { Scale = escala * 0.92 }, raiz)

	-- Sombras en capas (más grandes y más tenues hacia afuera) → profundidad
	local sombras = {}
	local destinos = { 0.80, 0.87, 0.92, 0.96 }
	for i = 1, 4 do
